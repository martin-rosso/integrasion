<h1>Element: <%= @element.synchronizable %></h1>

<%= link_to "Back to list", elements_path(folder_id: @element.folder.id) %>
| <%= link_to "Go to #{@element.folder}", folder_path(@element.folder) %>
<br>
<br>
<%= form_with(url: resolve_conflict_element_path(@element)) do |f| %>
  <%= f.submit "Resolve conflict" %>
<% end %>

<%= form_with(url: modify_local_element_path(@element)) do |f| %>
  <%= f.submit "Modify" %>
<% end %>

<%= form_with(url: update_status_element_path(@element)) do |f| %>
  <%= f.submit "Update status" %>
<% end %>

<%= form_with(url: perform_operation_element_path(@element)) do |f| %>
  <%= f.button(:operation, value: "delete") { "Delete" } %>
  <%= f.button(:operation, value: "fetch_remote") { "Fetch remote version" } %>
  <%= f.button(:operation, value: "perform_sync") { "Run perform_sync!" } %>
  <%= f.button(:operation, value: "increment_sequence") { "Increment local sequence" } %>
  <%= f.button(:operation, value: "discard") { "discard" } %>
<% end %>
<br>

<h4>Element</h4>
<pre>
<%= JSON.pretty_generate @element.as_json %>
</pre>

<h4><%= @element.synchronizable_type %></h4>
<pre>
<%= JSON.pretty_generate @element.synchronizable.as_json %>
</pre>

<h3>Versions</h3>
<table>
  <tr>
    <th></th>
    <th>Origin</th>
    <th>nev_status</th>
    <th>Sequence</th>
    <th>Payload status</th>
    <th>ETag</th>
    <th>Payload updated_at</th>
    <th>Created at</th>
    <th>Updated at</th>
  </tr>
  <% @element.element_versions.order(id: :desc).each do |version| %>
    <tr>
      <td><%= link_to "Show", element_version_path(version) %></td>
      <td><%= version.origin %></td>
      <td><%= version.nev_status %></td>
      <td><%= version.sequence %></td>
      <td><%= version.remote_status %></td>
      <td><%= version.etag %></td>
      <td><%= version.payload_updated_at %></td>
      <td><%= version.created_at %></td>
      <td><%= version.updated_at %></td>
    </tr>
  <% end %>
</table>
